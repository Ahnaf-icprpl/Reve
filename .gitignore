# ===================================================================
# Revé — Production .gitignore
# ===================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Environment variables, credentials, and secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example

# Logs and runtime diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime, process, and cache
pids/
*.pid
*.seed
*.pid.lock
.cache/
tmp/
temp/
.tmp/

# User-uploaded assets (keep directories tracked via .gitkeep)
public/uploads/*
!public/uploads/.gitkeep

# Database local storage, exports, and dump files
*.sqlite
*.sqlite3
*.db
*.db-journal
*.dump
*.sql.gz

# Coverage, testing, and reports
coverage/
*.lcov
.nyc_output/

# Build artifacts & distribution
dist/
build/
out/

# Operating system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDEs, text editors, and development tooling
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
*.bak

# Tool & agent runtime artifacts
.omp/
