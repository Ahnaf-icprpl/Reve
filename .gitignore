# ===================================================================
# Revé — Production .gitignore
# ===================================================================

# Dependencies
node_modules/
.pnp
.pnp.*

# Environment variables, credentials, and secrets
.env
.env.*
*.env
!.env.example
!.env.template

# Logs and runtime diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# Runtime, process, and cache
pids/
*.pid
*.seed
*.pid.lock
.cache/
.eslintcache
.parcel-cache/
.tmp/

# Temporary files
tmp/
temp/

# Database local storage, exports, and dump files
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
*.dump
*.sql.dump
*.sql.gz

# Coverage, testing, and reports
coverage/
*.lcov
.nyc_output/

# Build artifacts & distribution
dist/
build/
out/
.next/
.nuxt/

# Operating system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDEs, text editors, and development tooling
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
*.bak

# Tool & agent runtime artifacts
.omp/
.claude/
