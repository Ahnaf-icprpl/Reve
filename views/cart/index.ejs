<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="main-content">
  <div style="background-color: var(--bg-white); border-bottom: 1px solid var(--border-light); padding: 2rem 0 1.25rem;">
    <div class="container">
      <span class="section-label">Your Selection</span>
      <h1 class="editorial-heading" style="font-size: 2.25rem;">Shopping Bag</h1>
    </div>
  </div>

  <section class="container cart-layout">
    <% if (cart.items.length === 0) { %>
      <div style="grid-column: span 2; text-align: center; padding: 5rem 1rem;">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin: 0 auto 1rem; color: var(--text-muted);">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
        </svg>
        <h2 style="font-size: 1.5rem; margin-bottom: 0.5rem;">Your bag is currently empty</h2>
        <p style="color: var(--text-secondary); margin-bottom: 1.5rem; max-width: 400px; margin-left: auto; margin-right: auto;">
          Explore our marketplace of circular fashion items or trade in items from your wardrobe to earn tokens.
        </p>
        <div style="display: flex; gap: 1rem; justify-content: center;">
          <a href="/marketplace" class="btn btn-primary">Browse Marketplace</a>
          <a href="/trade-in" class="btn btn-secondary">Trade In Clothing</a>
        </div>
      </div>
    <% } else { %>
      <!-- Items list -->
      <div class="cart-items-list">

        <% cart.items.forEach(item => { %>
          <div class="cart-item-row">
            <img src="<%= item.product.image %>" alt="<%= item.product.title %>" class="cart-item-img">
            <div>
              <span style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.06em;">
                <%= item.product.brand %>
              </span>
              <h3 style="font-size: 1.05rem; font-weight: 600; margin: 0.15rem 0 0.35rem;">
                <a href="/marketplace/<%= item.product.id %>"><%= item.product.title %></a>
              </h3>
              <div style="font-size: 0.82rem; color: var(--text-secondary); display: flex; gap: 1rem;">
                <span>Size: <%= item.product.size %></span>
                <span>Condition: <%= item.product.condition %></span>
              </div>
              <div style="margin-top: 0.5rem; display: flex; gap: 0.75rem; align-items: baseline;">
                <span style="font-weight: 700; font-size: 1rem;">Rp <%= formatIdr(item.subtotal) %></span>
                <span style="font-size: 0.82rem; color: var(--token-green-dark); font-weight: 600;">
                  ✦ <%= formatIdr(item.tokenSubtotal || item.subtotal) %> RT
                </span>
                <% if (item.quantity > 1) { %>
                  <span style="font-size: 0.75rem; color: var(--text-muted);">(Rp <%= formatIdr(item.product.price) %> each)</span>
                <% } %>
              </div>
            </div>

            <!-- Quantity Controls and Remove Form -->
            <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 0.75rem;">
              <div class="cart-qty-control" style="display: flex; align-items: center; border: 1px solid var(--border-light); border-radius: var(--radius-sm); background: var(--bg-white);">
                <form action="/cart/update" method="POST" style="margin: 0; display: inline;">
                  <input type="hidden" name="productId" value="<%= item.product.id %>">
                  <input type="hidden" name="action" value="decrease">
                  <button type="submit" class="btn-qty" aria-label="Decrease quantity" title="Decrease quantity">&minus;</button>
                </form>
                <span class="qty-display"><%= item.quantity %></span>
                <form action="/cart/update" method="POST" style="margin: 0; display: inline;">
                  <input type="hidden" name="productId" value="<%= item.product.id %>">
                  <input type="hidden" name="action" value="increase">
                  <button type="submit" class="btn-qty" aria-label="Increase quantity" title="Increase quantity">&plus;</button>
                </form>
              </div>
              <form action="/cart/remove" method="POST">
                <input type="hidden" name="productId" value="<%= item.product.id %>">
                <button type="submit" class="btn btn-secondary btn-sm" style="color: #b91c1c; border-color: #fecaca; padding: 0.25rem 0.6rem; font-size: 0.75rem;">
                  Remove
                </button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>

      <!-- Cart Summary Sidebar -->
      <aside>
        <div class="cart-summary-card">
          <h2 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 1.25rem;">Order Summary</h2>

          <div class="calc-row">
            <span class="calc-label">Subtotal (<%= cart.count %> items)</span>
            <span class="calc-val">Rp <%= formatIdr(cart.subtotal) %></span>
          </div>

          <div class="calc-row">
            <span class="calc-label">Tokens Equivalent</span>
            <span class="calc-val" style="color: var(--token-green-dark);"><%= formatIdr(cart.tokenSubtotal) %> RT</span>
          </div>

          <div class="calc-row">
            <span class="calc-label">Carbon-Neutral Shipping</span>
            <span class="calc-val" style="color: var(--token-green-dark);">FREE</span>
          </div>

          <div class="calc-row total-row" style="margin-top: 0.5rem; padding-top: 1rem; border-top: 1px solid var(--border-light);">
            <span>Total</span>
            <div>
              <div style="font-size: 1.35rem; font-weight: 700;">Rp <%= formatIdr(cart.subtotal) %></div>
              <div style="font-size: 0.8rem; color: var(--token-green-dark); font-weight: 600; text-align: right;">
                or <%= formatIdr(cart.tokenSubtotal) %> RT
              </div>
            </div>
          </div>

          <!-- Token wallet balance status -->
          <div style="margin: 1.25rem 0; padding: 0.85rem; background-color: var(--bg-white); border: 1px solid var(--border-light); border-radius: var(--radius-sm); font-size: 0.82rem;">
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.25rem;">
              <span>Your Token Balance:</span>
              <strong><%= formatIdr(wallet.balance) %> RT</strong>
            </div>
            <% if (wallet.balance >= cart.tokenSubtotal) { %>
              <span style="color: var(--token-green-dark); font-weight: 600;">
                ✓ Sufficient balance to pay completely with tokens!
              </span>
            <% } else { %>
              <span style="color: var(--text-secondary);">
                You can apply your <%= formatIdr(wallet.balance) %> RT as a Rp <%= formatIdr(wallet.balance) %> discount at checkout.
              </span>
            <% } %>
          </div>

          <a href="/checkout" class="btn btn-primary btn-block btn-checkout" style="padding: 1rem; font-size: 1rem; font-weight: 700; text-align: center; display: block; border-radius: var(--radius-sm);">
            Proceed to Checkout &rarr;
          </a>

          <a href="/marketplace" class="btn btn-secondary btn-block" style="margin-top: 0.75rem; text-align: center;">
            Continue Shopping
          </a>
        </div>
      </aside>
    <% } %>
  </section>
</main>

<%- include('../partials/footer') %>
