<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="main-content">
  <div style="background-color: var(--bg-white); border-bottom: 1px solid var(--border-light); padding: 2rem 0 1.25rem;">
    <div class="container">
      <span class="section-label">Order Finalization</span>
      <h1 class="editorial-heading" style="font-size: 2.25rem;">Circular Checkout</h1>
    </div>
  </div>

  <section class="container checkout-layout">
    <!-- Checkout Form -->
    <form action="/checkout" method="POST" id="checkoutForm">
      <!-- 1. Shipping Details -->
      <div class="card-white" style="margin-bottom: 2rem;">
        <h2 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.5rem;">
          <span>1. Delivery Destination</span>
        </h2>
        <div style="display: grid; grid-template-columns: 1fr; gap: 1rem;">
          <div class="form-group">
            <label class="form-label" for="fullName">Full Name</label>
            <input type="text" id="fullName" name="fullName" class="form-input" value="Alex Rivera" required>
          </div>
          <div class="form-group">
            <label class="form-label" for="street">Street Address</label>
            <input type="text" id="street" name="street" class="form-input" value="742 Evergreen Terrace" required>
          </div>
          <div style="display: grid; grid-template-columns: 1.5fr 1fr 1fr; gap: 1rem;">
            <div class="form-group">
              <label class="form-label" for="city">City</label>
              <input type="text" id="city" name="city" class="form-input" value="Portland" required>
            </div>
            <div class="form-group">
              <label class="form-label" for="state">State</label>
              <input type="text" id="state" name="state" class="form-input" value="OR" required>
            </div>
            <div class="form-group">
              <label class="form-label" for="postalCode">Zip / Postal Code</label>
              <input type="text" id="postalCode" name="postalCode" class="form-input" value="97201" required>
            </div>
          </div>
        </div>
      </div>

      <!-- 2. Payment Method -->
      <div class="card-white" style="margin-bottom: 2rem;">
        <h2 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
          <span>2. Select Payment Method</span>
        </h2>
        <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 1.5rem;">
          Revé tokens maintain an exact 1:1 dollar value peg ($1.00 = 1 RT) when spent on circular fashion.
        </p>

        <div style="display: flex; flex-direction: column; gap: 1rem;">
          <!-- Option A: Full Tokens -->
          <label style="border: 1px solid var(--border-light); border-radius: var(--radius-sm); padding: 1.25rem; display: flex; gap: 1rem; align-items: flex-start; cursor: pointer; background-color: var(--bg-white);">
            <input type="radio" name="paymentMethod" value="tokens" <%= wallet.balance >= cart.tokenSubtotal ? 'checked' : 'disabled' %> style="margin-top: 0.25rem;">
            <div style="flex: 1;">
              <div style="display: flex; justify-content: space-between; align-items: center;">
                <strong style="font-size: 0.95rem;">Pay Full with Revé Tokens (RT)</strong>
                <span class="badge badge-token">1:1 Value ($1.00 = 1 RT)</span>
              </div>
              <p style="font-size: 0.82rem; color: var(--text-secondary); margin-top: 0.25rem;">
                Redeem <strong><%= cart.tokenSubtotal %> RT</strong> from your wallet. Current available balance: <strong><%= wallet.balance %> RT</strong>.
              </p>
              <% if (wallet.balance < cart.tokenSubtotal) { %>
                <span style="font-size: 0.75rem; color: #b91c1c; font-weight: 600;">
                  (Insufficient tokens for full payment. Choose Split or Card below.)
                </span>
              <% } %>
            </div>
          </label>

          <!-- Option B: Split Tokens + Card -->
          <label style="border: 1px solid var(--border-light); border-radius: var(--radius-sm); padding: 1.25rem; display: flex; gap: 1rem; align-items: flex-start; cursor: pointer; background-color: var(--bg-white);">
            <input type="radio" name="paymentMethod" value="split" <%= wallet.balance < cart.tokenSubtotal && wallet.balance > 0 ? 'checked' : '' %> style="margin-top: 0.25rem;">
            <div style="flex: 1;">
              <div style="display: flex; justify-content: space-between; align-items: center;">
                <strong style="font-size: 0.95rem;">Split: Redeem All <%= wallet.balance %> RT + Card Remainder</strong>
                <span class="badge badge-condition">Hybrid Payment</span>
              </div>
              <p style="font-size: 0.82rem; color: var(--text-secondary); margin-top: 0.25rem;">
                Redeem <%= Math.min(wallet.balance, cart.tokenSubtotal) %> RT as a $<%= Math.min(wallet.balance, cart.tokenSubtotal) %>.00 credit, pay $<%= Math.max(0, cart.subtotal - wallet.balance).toFixed(2) %> on card.
              </p>
            </div>
          </label>

          <!-- Option C: Traditional Card -->
          <label style="border: 1px solid var(--border-light); border-radius: var(--radius-sm); padding: 1.25rem; display: flex; gap: 1rem; align-items: flex-start; cursor: pointer; background-color: var(--bg-white);">
            <input type="radio" name="paymentMethod" value="card" <%= wallet.balance === 0 ? 'checked' : '' %> style="margin-top: 0.25rem;">
            <div style="flex: 1;">
              <div style="display: flex; justify-content: space-between; align-items: center;">
                <strong style="font-size: 0.95rem;">Credit / Debit Card</strong>
                <span style="font-size: 0.78rem; color: var(--text-muted);">Visa, MC, Amex</span>
              </div>
              <p style="font-size: 0.82rem; color: var(--text-secondary); margin-top: 0.25rem;">
                Pay $<%= cart.subtotal.toFixed(2) %> USD in full using credit/debit card. Keep your token balance intact.
              </p>
            </div>
          </label>
        </div>
      </div>

      <button type="submit" class="btn btn-primary btn-block" style="padding: 1.1rem; font-size: 1rem;">
        Authorize & Place Circular Order &rarr;
      </button>
    </form>

    <!-- Sidebar Order Review -->
    <aside>
      <div class="cart-summary-card">
        <h2 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 1.25rem;">Order Review</h2>

        <div style="display: flex; flex-direction: column; gap: 0.85rem; margin-bottom: 1.5rem; padding-bottom: 1.25rem; border-bottom: 1px solid var(--border-light);">
          <% cart.items.forEach(item => { %>
            <div style="display: flex; justify-content: space-between; gap: 1rem; font-size: 0.85rem;">
              <div style="flex: 1;">
                <strong><%= item.product.title %></strong>
                <div style="color: var(--text-muted); font-size: 0.78rem;">Size <%= item.product.size %> &bull; Qty <%= item.quantity %></div>
              </div>
              <div style="text-align: right;">
                <div>$<%= item.subtotal %></div>
                <div style="color: var(--token-green-dark); font-size: 0.75rem;"><%= item.subtotal %> RT</div>
              </div>
            </div>
          <% }) %>
        </div>

        <div class="calc-row">
          <span class="calc-label">Subtotal</span>
          <span class="calc-val">$<%= cart.subtotal.toFixed(2) %></span>
        </div>
        <div class="calc-row">
          <span class="calc-label">Token Peg (1:1)</span>
          <span class="calc-val" style="color: var(--token-green-dark);"><%= cart.tokenSubtotal %> RT</span>
        </div>
        <div class="calc-row">
          <span class="calc-label">Circular Delivery</span>
          <span class="calc-val" style="color: var(--token-green-dark);">FREE</span>
        </div>

        <div class="calc-row total-row" style="margin-top: 0.75rem; padding-top: 1rem; border-top: 1px solid var(--border-light);">
          <span>Total Due</span>
          <div style="text-align: right;">
            <div style="font-size: 1.35rem; font-weight: 700;">$<%= cart.subtotal.toFixed(2) %></div>
            <div style="font-size: 0.8rem; color: var(--token-green-dark); font-weight: 600;">or <%= cart.tokenSubtotal %> RT</div>
          </div>
        </div>

        <div style="margin-top: 1.5rem; padding: 1rem; background-color: var(--token-green-light); border: 1px solid var(--token-border); border-radius: var(--radius-sm); font-size: 0.8rem; color: var(--token-green-dark);">
          <strong>Circular Guarantee:</strong> Ozone sanitized, inspected, and shipped in 100% recycled biodegradable packaging.
        </div>
      </div>
    </aside>
  </section>
</main>

<%- include('../partials/footer') %>
