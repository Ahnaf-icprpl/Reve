<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="main-content">
  <div style="background-color: var(--bg-white); border-bottom: 1px solid var(--border-light); padding: 2.5rem 0 1.25rem;">
    <div class="container">
      <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 0.5rem;">
        <a href="/donate/track">&larr; Back to Donation History</a>
      </div>
      <span class="section-label">Circular Intake Pass</span>
      <h1 class="editorial-heading" style="font-size: 2.25rem;">Donation Pass #<%= donation.id %></h1>
    </div>
  </div>

  <section class="container" style="padding: 3rem 0 5rem; max-width: 800px;">
    <!-- Printable Pass Card -->
    <div class="card-white" style="padding: 2.5rem; border: 2px dashed var(--border-light); margin-bottom: 2rem;">
      <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 2rem; border-bottom: 1px solid var(--border-light); padding-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
        <div>
          <div class="brand-logo" style="margin-bottom: 0.5rem;">
            <span class="brand-name" style="font-size: 1.8rem;">Rev<span class="accent-e">é</span></span>
            <span class="brand-dot">.</span>
            <span class="brand-sub">CIRCULAR INTAKE</span>
          </div>
          <div style="font-size: 0.85rem; color: var(--text-muted);">
            Zero-Landfill Textile Reclamation Program
          </div>
        </div>

        <div style="text-align: right;">
          <span style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted);">
            Tracking Reference
          </span>
          <div style="font-family: monospace; font-size: 1.1rem; font-weight: 700;">
            <%= donation.trackingNumber %>
          </div>
        </div>
      </div>

      <!-- QR Code Mock Graphic & Summary -->
      <div style="display: grid; grid-template-columns: 140px 1fr; gap: 2rem; align-items: center; margin-bottom: 2rem;">
        <!-- Clean SVG QR Code Graphic -->
        <div style="width: 140px; height: 140px; border: 1px solid var(--border-light); padding: 0.5rem; display: flex; align-items: center; justify-content: center; background-color: var(--bg-white);">
          <svg width="120" height="120" viewBox="0 0 100 100" fill="#111827">
            <!-- QR code styling matrix -->
            <rect x="5" y="5" width="25" height="25" fill="#111827" />
            <rect x="9" y="9" width="17" height="17" fill="#ffffff" />
            <rect x="13" y="13" width="9" height="9" fill="#111827" />
            <rect x="70" y="5" width="25" height="25" fill="#111827" />
            <rect x="74" y="9" width="17" height="17" fill="#ffffff" />
            <rect x="78" y="13" width="9" height="9" fill="#111827" />
            <rect x="5" y="70" width="25" height="25" fill="#111827" />
            <rect x="9" y="74" width="17" height="17" fill="#ffffff" />
            <rect x="13" y="78" width="9" height="9" fill="#111827" />
            <!-- Data dots -->
            <rect x="36" y="10" width="6" height="6" />
            <rect x="48" y="16" width="6" height="6" />
            <rect x="42" y="28" width="6" height="6" />
            <rect x="54" y="10" width="6" height="6" />
            <rect x="10" y="42" width="6" height="6" />
            <rect x="22" y="48" width="6" height="6" />
            <rect x="16" y="54" width="6" height="6" />
            <rect x="36" y="42" width="12" height="12" />
            <rect x="56" y="42" width="6" height="6" />
            <rect x="68" y="48" width="12" height="6" />
            <rect x="48" y="60" width="6" height="12" />
            <rect x="36" y="78" width="12" height="6" />
            <rect x="60" y="72" width="6" height="12" />
            <rect x="72" y="78" width="18" height="12" />
          </svg>
        </div>

        <div>
          <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 0.5rem;"><%= donation.title %></h3>
          <div style="font-size: 0.88rem; color: var(--text-secondary); line-height: 1.6;">
            <strong>Pieces:</strong> <%= donation.itemCount %> Items<br>
            <strong>Designation:</strong> <%= donation.intendedProgram %><br>
            <strong>Handover Method:</strong> <%= donation.dropOffMethod %>
          </div>
        </div>
      </div>

      <!-- Instructions Box -->
      <div style="background-color: var(--bg-white); border: 1px solid var(--border-light); border-radius: var(--radius-sm); padding: 1.25rem; font-size: 0.85rem; line-height: 1.6; color: var(--text-secondary);">
        <strong style="color: var(--text-primary); display: block; margin-bottom: 0.5rem;">Next Steps:</strong>
        1. Pack your dry items into any reusable cardboard box or bag.<br>
        2. If shipping, tape this label to the box or show this QR code at any USPS / UPS counter.<br>
        3. If visiting a Revé partner drop-off hub, simply scan this digital pass upon arrival.<br>
        4. No postage is required. Revé covers 100% of transport costs for circular recovery.
      </div>
    </div>

    <div style="display: flex; gap: 1rem; justify-content: center;">
      <button onclick="window.print()" class="btn btn-secondary">
        🖨 Print Pass / Label
      </button>
      <a href="/donate/track" class="btn btn-primary">
        View Circular Impact Dashboard &rarr;
      </a>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
