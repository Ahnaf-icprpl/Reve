<header class="site-header">

  <nav class="main-navbar">
    <div class="container navbar-container">
      <!-- Mobile menu trigger -->
      <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Toggle navigation menu">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>

      <!-- All-text brand logo: Revé -->
      <a href="/" class="brand-logo" aria-label="Revé Home">
        <span class="brand-name">Rev<span class="accent-e">é</span></span>
        <span class="brand-dot">.</span>
      </a>

      <!-- Primary nav links -->
      <div class="nav-links" id="navLinks">
        <a href="/marketplace" class="nav-item <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/marketplace')) ? 'active' : '' %>">
          Marketplace
        </a>
        <a href="/trade-in" class="nav-item <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/trade-in')) ? 'active' : '' %>">
          Trade-In
        </a>
        <a href="/donate" class="nav-item <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/donate')) ? 'active' : '' %>">
          Donate & Recycle
        </a>
        <a href="/about" class="nav-item <%= (typeof currentPath !== 'undefined' && currentPath === '/about') ? 'active' : '' %>">
          How It Works
        </a>
        <a href="/cart" class="nav-item mobile-only-cart <%= (typeof currentPath !== 'undefined' && currentPath === '/cart') ? 'active' : '' %>">
          Bag (<%= (typeof cart !== 'undefined' && cart && cart.count) ? cart.count : 0 %>)
        </a>
      </div>

      <!-- User profile badge: circle pfp icon and name -->
      <div class="navbar-actions">
        <!-- Shopping Bag Link -->
        <a href="/cart" class="nav-cart-btn <%= (typeof currentPath !== 'undefined' && currentPath === '/cart') ? 'active' : '' %>" title="View Shopping Bag" aria-label="Shopping Bag">
          <div class="nav-cart-icon-wrap">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
            <% const bagCount = (typeof cart !== 'undefined' && cart && cart.count) ? cart.count : 0; %>
            <span class="nav-cart-count <%= bagCount > 0 ? 'has-items' : '' %>" id="navCartCount"><%= bagCount %></span>
          </div>
          <span class="nav-cart-label">Bag</span>
        </a>

        <!-- User profile badge -->
        <a href="/profile" class="user-profile-nav" title="View Profile">
          <div class="profile-pfp-circle" aria-label="Profile picture">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
          </div>
          <span class="profile-name"><%= currentUser.name %></span>
          <% if (typeof badges !== 'undefined' && badges && badges.length > 0) { %>
            <span class="badge-icon-item" style="width: 22px; height: 22px; margin-left: -0.2rem;" title="<%= badges[0].title %>">
              <%- badges[0].svg %>
            </span>
          <% } %>
        </a>
      </div>
    </div>
  </nav>
</header>
<%- include('./toast') %>
