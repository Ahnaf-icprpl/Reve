<header class="site-header">

  <nav class="main-navbar">
    <div class="container navbar-container">
      <!-- Mobile menu trigger -->
      <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Toggle navigation menu">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>

      <!-- All-text brand logo: Revé -->
      <a href="/" class="brand-logo" aria-label="Revé Home">
        <span class="brand-name">Rev<span class="accent-e">é</span></span>
        <span class="brand-dot">.</span>
      </a>

      <!-- Primary nav links -->
      <div class="nav-links" id="navLinks">
        <a href="/marketplace" class="nav-item <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/marketplace')) ? 'active' : '' %>">
          Marketplace
        </a>
        <a href="/trade-in" class="nav-item <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/trade-in')) ? 'active' : '' %>">
          Trade-In
        </a>
        <a href="/donate" class="nav-item <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/donate')) ? 'active' : '' %>">
          Donate & Recycle
        </a>
        <a href="/about" class="nav-item <%= (typeof currentPath !== 'undefined' && currentPath === '/about') ? 'active' : '' %>">
          How It Works
        </a>
      </div>

      <!-- User action utilities: Token balance chip & Cart -->
      <div class="navbar-actions">
        <!-- Live Token Balance Chip -->
        <div class="token-balance-chip" style="cursor: default;" title="Revé Tokens available for circular checkout">
          <span class="token-icon">✦</span>
          <span class="token-label">Tokens</span>
          <span class="token-amount">
            <%= (typeof wallet !== 'undefined' && wallet.balance !== undefined) ? wallet.balance : 150 %> RT
          </span>
          <span class="token-fiat">
            ($<%= (typeof wallet !== 'undefined' && wallet.balance !== undefined) ? wallet.balance : 150 %>.00)
          </span>
        </div>

        <!-- Orders link -->
        <a href="/orders" class="nav-icon-link" title="Order History" aria-label="Orders">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
        </a>

        <!-- Shopping Bag -->
        <a href="/cart" class="nav-bag-link" title="Shopping Bag" aria-label="Cart">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <% 
            const bagCount = (typeof cart !== 'undefined' && cart && cart.count) ? cart.count : 0;
          %>
          <span class="bag-count-badge <%= bagCount > 0 ? 'visible' : '' %>"><%= bagCount %></span>
        </a>
      </div>
    </div>
  </nav>
</header>
<%- include('./toast') %>
