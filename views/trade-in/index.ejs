<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="main-content">
  <!-- Trade-in Header -->
  <section style="padding: 3rem 0 1.5rem; background-color: var(--bg-white); border-bottom: 1px solid var(--border-light);">
    <div class="container">
      <div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1rem;">
        <div>
          <span class="section-label">Circular Trade-In</span>
          <h1 class="editorial-heading" style="font-size: 2.5rem; margin-bottom: 0.5rem;">
            Turn Unwanted Wardrobe into Tokens
          </h1>
          <p style="color: var(--text-secondary); max-width: 680px; font-size: 0.95rem;">
            Submit quality garments you no longer wear. Receive an instant token valuation.
          </p>
        </div>
        <div>
          <a href="/trade-in/track" class="btn btn-secondary">
            View My Submissions &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Submission Form & Live Estimator Layout -->
  <section class="container" style="padding: 3.5rem 0 5rem;">
    <div style="display: grid; grid-template-columns: 1.25fr 0.85fr; gap: 3.5rem;">
      <!-- Submission Form -->
      <div>
        <form action="/trade-in" method="POST" enctype="multipart/form-data" class="card-white" style="padding: 2rem;">
          <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border-light); padding-bottom: 0.75rem;">
            Garment Details
          </h2>

          <div class="form-group">
            <label class="form-label" for="tiTitle">Item Name / Headline</label>
            <input type="text" id="tiTitle" name="title" class="form-input" placeholder="e.g. Patagonia Retro-X Deep Pile Fleece" required>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            <div class="form-group">
              <label class="form-label" for="tiBrand">Brand</label>
              <input type="text" id="tiBrand" name="brand" list="brandOptions" class="form-input" placeholder="Type or select a brand..." required value="Patagonia" autocomplete="off">
              <datalist id="brandOptions">
                <option value="Arc'teryx">
                <option value="Patagonia">
                <option value="The North Face">
                <option value="Barbour">
                <option value="Fjällräven">
                <option value="Woolrich">
                <option value="A.P.C.">
                <option value="Acne Studios">
                <option value="COS">
                <option value="Everlane">
                <option value="Reformation">
                <option value="Sézane">
                <option value="Ganni">
                <option value="Eileen Fisher">
                <option value="Nudie Jeans">
                <option value="Arket">
                <option value="Levi's">
                <option value="Carhartt WIP">
                <option value="Carhartt">
                <option value="Ralph Lauren">
                <option value="Uniqlo">
                <option value="Massimo Dutti">
                <option value="Zara">
                <option value="Other / Independent Label">
              </datalist>
              <div style="display: flex; gap: 0.35rem; flex-wrap: wrap; margin-top: 0.4rem;" id="quickBrandChips">
                <button type="button" class="badge badge-condition brand-chip" data-brand="Patagonia" style="cursor: pointer;">Patagonia</button>
                <button type="button" class="badge badge-condition brand-chip" data-brand="Arc'teryx" style="cursor: pointer;">Arc'teryx</button>
                <button type="button" class="badge badge-condition brand-chip" data-brand="Levi's" style="cursor: pointer;">Levi's</button>
                <button type="button" class="badge badge-condition brand-chip" data-brand="Everlane" style="cursor: pointer;">Everlane</button>
                <button type="button" class="badge badge-condition brand-chip" data-brand="COS" style="cursor: pointer;">COS</button>
                <button type="button" class="badge badge-condition brand-chip" data-brand="A.P.C." style="cursor: pointer;">A.P.C.</button>
              </div>
            </div>
            <div class="form-group">
              <label class="form-label" for="tiCategory">Category</label>
              <select id="tiCategory" name="category" class="form-select" required>
                <option value="Outerwear">Outerwear (Jackets, Coats)</option>
                <option value="Knitwear">Knitwear (Sweaters, Cardigans)</option>
                <option value="Bottoms">Bottoms (Denim, Trousers)</option>
                <option value="Tops">Tops (Shirts, Blouses)</option>
                <option value="Dresses">Dresses & Jumpsuits</option>
                <option value="Accessories">Accessories & Bags</option>
              </select>
            </div>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;">
            <div class="form-group">
              <label class="form-label" for="tiGender">Gender</label>
              <select id="tiGender" name="gender" class="form-select">
                <option value="Unisex">Unisex</option>
                <option value="Men">Men</option>
                <option value="Women">Women</option>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label" for="tiSize">Size</label>
              <input type="text" id="tiSize" name="size" class="form-input" placeholder="e.g. M, 32x32" value="M" required>
            </div>

            <div class="form-group">
              <label class="form-label" for="tiCondition">Condition Rating</label>
              <select id="tiCondition" name="condition" class="form-select" required>
                <option value="Like New">Like New (Flawless, barely worn)</option>
                <option value="Excellent" selected>Excellent (Gently used, no flaws)</option>
                <option value="Good">Good (Minor signs of wear)</option>
                <option value="Fair">Fair (Wearable, light repairs)</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="tiMaterial">Material / Fiber Composition</label>
            <input type="text" id="tiMaterial" name="material" class="form-input" placeholder="e.g. 100% Recycled Polyester Fleece, Organic Cotton">
          </div>

          <div class="form-group">
            <label class="form-label" for="tiNotes">Item Condition Notes & Flaws</label>
            <textarea id="tiNotes" name="notes" rows="3" class="form-textarea" placeholder="Describe any wear, alterations, zipper condition, or stains..."></textarea>
          </div>

          <div class="form-group">
            <label class="form-label">Garment Photograph</label>
            <input type="file" name="photo" accept="image/*" class="form-input" style="padding: 0.5rem;">
            <span style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">
              Or optionally leave blank to generate standard circular intake placeholder.
            </span>
          </div>

          <button type="submit" class="btn btn-primary btn-block" style="padding: 1.1rem; font-size: 1rem; margin-top: 1rem;">
            Submit Trade-in for Valuation &rarr;
          </button>
        </form>
      </div>

      <!-- Live Dynamic Valuation Estimator Sidebar -->
      <aside>
        <div class="card-white" style="border-color: var(--token-green); position: sticky; top: 6rem;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <span class="section-label" style="margin: 0;">Instant Valuation Preview</span>
            <span class="badge badge-token">1:1 Token Peg</span>
          </div>

          <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 0.5rem;">
            Estimated Offer:
          </h3>

          <div style="padding: 1.5rem; background-color: var(--token-green-light); border: 1px solid var(--token-border); border-radius: var(--radius-sm); text-align: center; margin-bottom: 1.5rem;">
            <div id="tiEstimateDisplay" style="font-size: 2.75rem; font-weight: 800; color: var(--token-green-dark); line-height: 1;">
              115 RT
            </div>
            <div id="tiFiatDisplay" style="font-size: 0.88rem; font-weight: 600; color: var(--token-green-dark); margin-top: 0.35rem;">
              $115.00 Marketplace Purchasing Value
            </div>
          </div>

          <div style="display: flex; flex-direction: column; gap: 0.75rem; font-size: 0.85rem; color: var(--text-secondary); line-height: 1.5;">
            <div style="display: flex; gap: 0.5rem;">
              <span style="color: var(--token-green); font-weight: 700;">✓</span>
              <span><strong>100% Value Inside Revé:</strong> Spend the full token amount on any clothing listing in our marketplace.</span>
            </div>
            <div style="display: flex; gap: 0.5rem;">
              <span style="color: var(--token-green); font-weight: 700;">✓</span>
              <span><strong>Cash-out Option:</strong> Convert to dollars ($) via digital wallet whenever you prefer (subject to 20% conversion deduction).</span>
            </div>
            <div style="display: flex; gap: 0.5rem;">
              <span style="color: var(--token-green); font-weight: 700;">✓</span>
              <span><strong>Prepaid Shipping:</strong> A prepaid drop-off label is generated immediately upon offer acceptance.</span>
            </div>
          </div>

          <div style="margin-top: 1.75rem; padding-top: 1.25rem; border-top: 1px solid var(--border-light);">
            <a href="/trade-in/track" style="font-size: 0.85rem; font-weight: 700; color: var(--text-primary); display: flex; align-items: center; justify-content: space-between;">
              <span>Track previously submitted trade-ins</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>
      </aside>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
