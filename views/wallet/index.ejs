<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="main-content">
  <!-- Wallet Hero Header -->
  <section class="wallet-hero">
    <div class="container">
      <div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1rem;">
        <div>
          <span class="section-label">Digital Token Ledger</span>
          <h1 class="editorial-heading" style="font-size: 2.5rem; margin-bottom: 0.5rem;">
            Revé Token Wallet
          </h1>
          <p style="color: var(--text-secondary); max-width: 680px; font-size: 0.95rem;">
            Revé tokens reward participation in circular fashion. Tokens hold 1:1 value when spent on clothing, while cashing out incurs a 20% deduction to incentivize closed-loop reuse.
          </p>
        </div>

        <!-- Quick Demo Top-Up for testing -->
        <form action="/wallet/topup" method="POST" style="display: flex; gap: 0.5rem; align-items: center;">
          <input type="hidden" name="amount" value="50">
          <button type="submit" class="btn btn-secondary btn-sm" title="Add 50 RT to balance for testing">
            + Quick Add 50 RT (Demo)
          </button>
        </form>
      </div>

      <!-- 3 Key Metric Cards: Balance, Marketplace Power (1:1), and Cash-Out Valuation -->
      <div class="wallet-balance-grid">
        <!-- Card 1: Token Balance -->
        <div class="wallet-card card-primary">
          <div class="wallet-card-header">
            <span class="wallet-card-title">Token Balance</span>
            <span class="badge badge-token">✦ Active</span>
          </div>
          <div class="wallet-card-value">
            <%= wallet.balance %> <span style="font-size: 1.25rem; font-weight: 600; color: var(--token-green-dark);"><%= wallet.symbol %></span>
          </div>
          <div class="wallet-card-caption">
            Earned via trade-in assessments and verified sustainable clothing returns.
          </div>
        </div>

        <!-- Card 2: Marketplace Purchasing Power (1:1 Peg) -->
        <div class="wallet-card">
          <div class="wallet-card-header">
            <span class="wallet-card-title">Marketplace Value</span>
            <span class="badge badge-token" style="background-color: var(--bg-white);">1:1 Value Peg</span>
          </div>
          <div class="wallet-card-value" style="color: var(--text-primary);">
            $<%= wallet.marketplacePower.toFixed(2) %>
          </div>
          <div class="wallet-card-caption">
            100% full purchasing power when redeemed on circular clothing in the marketplace.
          </div>
        </div>

        <!-- Card 3: Cash Payout Valuation (Reduced) -->
        <div class="wallet-card">
          <div class="wallet-card-header">
            <span class="wallet-card-title">Cash-Out Valuation</span>
            <span class="badge" style="background-color: #fef2f2; color: #991b1b; border-color: #fecaca;">
              <%= wallet.deductionRatePct %>% Conversion Deduction
            </span>
          </div>
          <div class="wallet-card-value" style="color: var(--text-secondary);">
            $<%= wallet.cashOutValue.toFixed(2) %>
          </div>
          <div class="wallet-card-caption">
            Net cash payout if converted to fiat. $<%= wallet.deductionAmount.toFixed(2) %> deduction retains value in circularity.
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Cash-Out Withdrawal Section & Live Calculator -->
  <section class="cashout-section">
    <div class="container cashout-grid">
      <!-- Withdrawal Form -->
      <div class="card-white" style="padding: 2rem;">
        <span class="section-label">Conversion & Payout</span>
        <h2 style="font-size: 1.35rem; font-weight: 700; margin-bottom: 0.5rem;">
          Convert Tokens into Real Money
        </h2>
        <p style="font-size: 0.88rem; color: var(--text-secondary); margin-bottom: 1.5rem; line-height: 1.5;">
          Per the circular specification, converting tokens to fiat cash incurs a <%= wallet.deductionRatePct %>% conversion deduction to prioritize clothing reuse.
        </p>

        <form action="/wallet/withdraw" method="POST" id="withdrawForm">
          <div class="form-group">
            <div style="display: flex; justify-content: space-between; align-items: baseline;">
              <label class="form-label" for="withdrawTokenAmount">Tokens to Convert (RT)</label>
              <span style="font-size: 0.75rem; color: var(--text-muted);">
                Max available: <strong><%= wallet.balance %> RT</strong>
              </span>
            </div>
            <div style="position: relative;">
              <input type="number" id="withdrawTokenAmount" name="tokenAmount" class="form-input" min="1" max="<%= wallet.balance %>" value="<%= Math.min(50, wallet.balance) %>" required style="font-size: 1.25rem; font-weight: 700; padding-right: 4rem;">
              <span style="position: absolute; right: 1rem; top: 50%; transform: translateY(-50%); font-weight: 700; color: var(--token-green-dark); font-size: 0.9rem;">
                RT
              </span>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="payoutDestination">Payout Method</label>
            <select id="payoutDestination" name="payoutDestination" class="form-select" required>
              <option value="Direct ACH Bank Transfer">Direct ACH Bank Transfer (1-2 business days)</option>
              <option value="PayPal Express Payout">PayPal Instant Transfer</option>
              <option value="Debit Card Fast Funds">Debit Card Direct Deposit</option>
              <option value="Local Currency Wire">Local Currency Bank Account</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="accountNumber">Account / IBAN / PayPal Email</label>
            <input type="text" id="accountNumber" name="accountNumber" class="form-input" placeholder="e.g. alex.rivera@example.com or Account #••••4921" value="••••-••••-7819" required>
          </div>

          <!-- Live Conversion Deduction Breakdown Preview -->
          <div class="conversion-calculator-box" style="margin: 1.5rem 0;">
            <div style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.5rem; letter-spacing: 0.06em;">
              Expected Cash Payout Preview
            </div>

            <div class="calc-row">
              <span class="calc-label">Tokens Converted:</span>
              <span class="calc-val" id="calcTokensDisplay">50 RT</span>
            </div>

            <div class="calc-row">
              <span class="calc-label">Nominal 1:1 Value:</span>
              <span class="calc-val" id="calcGrossDisplay">$50.00</span>
            </div>

            <div class="calc-row">
              <span class="calc-label">
                Conversion Deduction (<%= wallet.deductionRatePct %>%):
                <span style="font-size: 0.72rem; color: var(--text-muted); display: block;">Retained to fund textile sorting & hubs</span>
              </span>
              <span class="calc-val calc-deduction" id="calcDeductionDisplay">-$10.00</span>
            </div>

            <div class="calc-row total-row">
              <span class="calc-label">Net Cash Payout:</span>
              <span class="calc-payout" id="calcPayoutDisplay">$40.00</span>
            </div>
          </div>

          <button type="submit" class="btn btn-primary btn-block" style="padding: 1.1rem; font-size: 1rem;" <%= wallet.balance <= 0 ? 'disabled' : '' %>>
            Confirm & Withdraw Cash Payout &rarr;
          </button>
        </form>
      </div>

      <!-- Comparison Explainer & Circular Economy Context -->
      <div style="display: flex; flex-direction: column; gap: 1.5rem;">
        <div class="card-white" style="border-color: var(--token-green); padding: 1.75rem;">
          <span class="section-label">Economic Architecture</span>
          <h3 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 1rem;">
            Why does Revé use a Dual-Value Token?
          </h3>
          <p style="font-size: 0.88rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 1rem;">
            Most secondhand resale programs suffer from high cash-out leakages where value exits the sustainable system. Revé solves this with an intentional divergence between platform redemption and external conversion:
          </p>

          <div style="display: flex; flex-direction: column; gap: 1rem; font-size: 0.85rem;">
            <div style="background-color: var(--token-green-light); border: 1px solid var(--token-border); padding: 1rem; border-radius: var(--radius-sm); color: var(--token-green-dark);">
              <strong>1:1 Clothing Peg:</strong> 1 Token buys $1.00 of circular clothing. This gives your unwanted garments the highest purchasing power within the circular community.
            </div>

            <div style="background-color: var(--bg-white); border: 1px solid var(--border-light); padding: 1rem; border-radius: var(--radius-sm); color: var(--text-secondary);">
              <strong>20% Cash Deduction:</strong> Converting tokens to real cash incurs a deduction that directly covers ozone sanitization, circular sorting, and zero-landfill shredding operations.
            </div>
          </div>
        </div>

        <div class="card-white" style="padding: 1.5rem;">
          <h4 style="font-size: 0.95rem; font-weight: 700; margin-bottom: 0.5rem;">
            Need more tokens?
          </h4>
          <p style="font-size: 0.82rem; color: var(--text-secondary); margin-bottom: 1rem; line-height: 1.5;">
            You can earn more tokens at any time by submitting quality garments from your wardrobe to our Trade-In program.
          </p>
          <a href="/trade-in" class="btn btn-secondary btn-sm">
            Start a Wardrobe Trade-In &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Complete Transaction Ledger -->
  <section class="ledger-section">
    <div class="container">
      <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
        <div>
          <span class="section-label">Audit Trail</span>
          <h2 style="font-size: 1.5rem; font-weight: 700;">Wallet Transaction Ledger</h2>
          <p style="font-size: 0.88rem; color: var(--text-secondary);">
            Full historical transparency of all token credits, debits, marketplace redemptions, and fiat conversions.
          </p>
        </div>

        <!-- Ledger Filter Tabs -->
        <div style="display: flex; gap: 0.5rem; font-size: 0.82rem;">
          <a href="/wallet?type=ALL" class="btn btn-sm <%= selectedFilter === 'ALL' ? 'btn-primary' : 'btn-secondary' %>">All</a>
          <a href="/wallet?type=TRADE_IN_CREDIT" class="btn btn-sm <%= selectedFilter === 'TRADE_IN_CREDIT' ? 'btn-primary' : 'btn-secondary' %>">Trade-ins</a>
          <a href="/wallet?type=MARKETPLACE_PURCHASE" class="btn btn-sm <%= selectedFilter === 'MARKETPLACE_PURCHASE' ? 'btn-primary' : 'btn-secondary' %>">Purchases</a>
          <a href="/wallet?type=CASH_CONVERSION_WITHDRAWAL" class="btn btn-sm <%= selectedFilter === 'CASH_CONVERSION_WITHDRAWAL' ? 'btn-primary' : 'btn-secondary' %>">Cash-outs</a>
        </div>
      </div>

      <div class="ledger-table-wrap">
        <table class="ledger-table">
          <thead>
            <tr>
              <th>Date</th>
              <th>Type</th>
              <th>Description / Reference</th>
              <th>Token Change</th>
              <th>Balance After</th>
              <th>Equivalent Value</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% if (ledger.length === 0) { %>
              <tr>
                <td colspan="7" style="text-align: center; padding: 2.5rem; color: var(--text-muted);">
                  No ledger transactions matching this filter.
                </td>
              </tr>
            <% } else { %>
              <% ledger.forEach(tx => { %>
                <tr>
                  <td style="font-size: 0.82rem; color: var(--text-muted); white-space: nowrap;">
                    <%= new Date(tx.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                  </td>
                  <td>
                    <% if (tx.type === 'TRADE_IN_CREDIT') { %>
                      <span class="badge badge-token">Trade-In Credit</span>
                    <% } else if (tx.type === 'MARKETPLACE_PURCHASE') { %>
                      <span class="badge badge-condition">Marketplace Purchase</span>
                    <% } else if (tx.type === 'CASH_CONVERSION_WITHDRAWAL') { %>
                      <span class="badge" style="background-color: #fef2f2; color: #991b1b; border-color: #fecaca;">Cash Conversion</span>
                    <% } else { %>
                      <span class="badge badge-token"><%= tx.type %></span>
                    <% } %>
                  </td>
                  <td>
                    <div style="font-weight: 600;"><%= tx.title %></div>
                    <div style="font-size: 0.75rem; color: var(--text-muted); font-family: monospace;">Ref: <%= tx.referenceId %></div>
                  </td>
                  <td>
                    <% if (tx.tokenChange > 0) { %>
                      <span class="token-positive">+<%= tx.tokenChange %> RT</span>
                    <% } else { %>
                      <span class="token-negative"><%= tx.tokenChange %> RT</span>
                    <% } %>
                  </td>
                  <td style="font-weight: 600;">
                    <%= tx.balanceAfter %> RT
                  </td>
                  <td style="font-size: 0.85rem; color: var(--text-secondary);">
                    $<%= tx.fiatEquivalent.toFixed(2) %> USD
                  </td>
                  <td>
                    <span style="font-size: 0.78rem; font-weight: 600; color: var(--token-green-dark);">
                      ● <%= tx.status %>
                    </span>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
